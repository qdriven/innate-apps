# 调研用 upstream clone，不属于本仓库
/dsh-superagent-prototype/
# 实验项目：独立 git 仓库（fork upstream），不作为本仓库内容追踪
/dsh-innate-agent/

# scripts/ 下多为本地一次性脚本，默认不入库；
# 仅白名单下列出的仓库级脚本（含每日签到自动化）纳入版本管理。
!/scripts/
/scripts/*
!/scripts/validate-registry.mjs
!/scripts/check-layout-doc.mjs
!/scripts/render-profile.mjs
!/scripts/render-profile.test.mjs
!/scripts/package.json
!/scripts/daily-checkin.ts
!/scripts/mcode-sign-salt.ts
!/scripts/mcode-sign-salt-lib.ts
!/scripts/workbuddy-checkin.ts
!/scripts/workbuddy-cdp.ts
!/scripts/run-mcode-checkin.cmd
!/scripts/run-workbuddy-checkin.cmd

# 各 app 与工具项目：独立 git 仓库（registry/README.md 约定，非 submodule），
# 仅作为本地 checkout，不作为本仓库内容追踪
/innate-daily/
/innate-fe-examples/
/innate-feeds/
/innate-skills/
/innate-vytdl/
/spark-cli/
/try-catch/

# skills/ 下默认忽略：独立 git 仓库的 checkout 不纳入本仓库内容追踪
# （不做 submodule，只当本地依赖）。内容型 skill 目录（手写的 SKILL.md 等）
# 需要入库时，在下方白名单里显式列出。
/skills/*/
!/skills/anti-hallucination-gates/
!/skills/browser-skills/
!/skills/docs/

# references/ 下默认忽略：独立 git 仓库 checkout 与网页抓取快照都不入库
/references/*/

# 工具与插件的产物目录，不纳入版本管理
# .workbuddy/：本地工具的每日记忆日志（运行时产物）
/.workbuddy/
# plugins/：插件 checkout，含 node_modules 等依赖产物
/plugins/

# innate-music/ 的 data/ 是抓取下来的歌词正文——有版权，不入库。
# 脚本与文档属于内容型文件，正常入库。
/innate-music/data/

# macOS
.DS_Store
